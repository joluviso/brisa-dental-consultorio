---
import Icon from './Icon.astro';
---

<footer class="site-footer">
  <div class="site-container">
    <div class="footer-cta">
      <div>
        <span class="eyebrow eyebrow-light">Nos dará gusto conocerte</span>
        <h2>
          Dale a tu sonrisa
          <br /> un <span>nuevo comienzo.</span>
        </h2>
      </div>
      <a class="button button-light" href="#contacto" data-whatsapp="valuation">
        Agenda tu valoración <Icon name="whatsapp" class="whatsapp-icon" />
      </a>
    </div>
    <div class="footer-grid">
      <div class="footer-brand">
        <a
          class="brand brand-light"
          href="#inicio"
          aria-label="Brisa Dental, inicio"
        >
          brisa<span class="brand-dot">.</span>
          <span class="brand-sub">DENTAL</span>
        </a>
        <p>Sonríe con tranquilidad.</p>
        <span>Clínica dental integral.</span>
      </div>
      <div>
        <h3>Te esperamos</h3>
        <p>
          Lunes a viernes
          <br /> <strong>9:00 a 19:00 h</strong>
        </p>
        <p>
          Sábado
          <br /> <strong>9:00 a 14:00 h</strong>
        </p>
        <span class="footer-note">Horario ilustrativo</span>
      </div>
      <div>
        <h3>Conoce Brisa</h3>
        <a href="#nosotros">Nuestra clínica</a>
        <a href="#tratamientos">Tratamientos</a>
        <a href="#equipo">Nuestro equipo</a>
        <a href="#preguntas">Preguntas frecuentes</a>
      </div>
      <div>
        <h3>Sigamos en contacto</h3>
        <p>
          Tu próxima sonrisa empieza
          <br /> con una conversación.
        </p>
        <a class="footer-contact" href="#contacto" data-whatsapp="valuation">
          Solicita tu valoración <Icon name="whatsapp" class="whatsapp-icon" />
        </a>
        <span class="footer-email">hola@brisadental.example</span>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© 2026 Brisa Dental. Marca y contenido de demostración.</p>
      <a href="#inicio">
        Volver al inicio <Icon name="arrow" />
      </a>
    </div>
  </div>
</footer>
