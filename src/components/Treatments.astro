---
import Icon from './Icon.astro';
import { treatments } from '../data/content';
---

<section
  class="section surface"
  id="tratamientos"
  aria-labelledby="services-title"
>
  <div class="site-container">
    <div class="section-heading heading-row">
      <div>
        <span class="eyebrow">Nuestros tratamientos</span>
        <h2 id="services-title">
          Un cuidado completo
          <br /> para <span class="accent-text">cada sonrisa.</span>
        </h2>
      </div>
      <div class="heading-aside">
        <p>
          Desde tu revisión de rutina hasta un plan de atención más completo, te
          ayudamos a conocer tus opciones.
        </p>
        <a class="text-link" href="#contacto" data-whatsapp="valuation">
          Encuentra tu tratamiento{' '}
          <Icon name="whatsapp" class="whatsapp-icon" />
        </a>
      </div>
    </div>
    <div class="service-grid">
      {treatments.map((item, index) => (
        <article class="service-card">
          <div class="card-image">
            <img
              src={item.image}
              width={item.width}
              height={item.height}
              alt={item.alt}
              loading="lazy"
            />
            <span class="card-number">
              {String(index + 1).padStart(2, '0')}
            </span>
          </div>
          <div class="service-body">
            <h3>
              {item.title.map((line, index) => (
                <>
                  {index > 0 && <br />}
                  {line}
                </>
              ))}
            </h3>
            <p>{item.description}</p>
            <a
              class="card-link"
              href="#contacto"
              data-whatsapp="valuation"
              data-treatment={item.treatment}
              aria-label={item.ariaLabel}
            >
              Solicitar valoración{' '}
              <span class="arrow-circle">
                <Icon name="whatsapp" class="whatsapp-icon" />
              </span>
            </a>
          </div>
        </article>
      ))}
    </div>
    <p class="section-footnote">
      ¿No sabes por dónde empezar?{' '}
      <a
        href="#contacto"
        data-whatsapp="valuation"
        data-treatment="Quiero orientación"
      >
        Estamos para orientarte.
      </a>
    </p>
  </div>
</section>
