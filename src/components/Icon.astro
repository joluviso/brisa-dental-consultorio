---
interface Props {
  name:
    | 'whatsapp'
    | 'arrow'
    | 'diagonal'
    | 'check'
    | 'heart'
    | 'calendar'
    | 'message'
    | 'spark';
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg class:list={['icon', className]} aria-hidden="true">
  <use href={`#i-${name}`} />
</svg>
