---
---

<section
  class="section transformations surface"
  id="resultados"
  aria-labelledby="results-title"
>
  <div class="site-container">
    <div class="section-heading centered">
      <span class="eyebrow">Antes y después</span>
      <h2 id="results-title">
        El cambio se aprecia
        <br /> en <span class="accent-text">los detalles.</span>
      </h2>
      <p>Desliza para explorar estas imágenes ilustrativas.</p>
    </div>
    <div class="three-grid comparisons">
      <article class="comparison-card">
        <div class="comparison" style="--position:50%">
          <img
            class="comparison-after"
            src="/assets/images/transformation-img-after-1.webp"
            width="1200"
            height="800"
            alt="Después: ejemplo de sonrisa de tono más claro"
            loading="lazy"
          />
          <img
            class="comparison-before"
            src="/assets/images/transformation-img-before-1.webp"
            width="1200"
            height="800"
            alt="Antes: tono original de la sonrisa ilustrativa"
            loading="lazy"
          />
          <span class="compare-label label-before">Antes</span>
          <span class="compare-label label-after">Después</span>
          <div class="comparison-divider" aria-hidden="true">
            <span>‹ ›</span>
          </div>
          <input
            class="comparison-slider"
            type="range"
            min="0"
            max="100"
            value="50"
            aria-label="Comparar antes y después del tono de la sonrisa"
            aria-valuetext="50% de la imagen antes visible"
          />
        </div>
        <h3>Tono de la sonrisa</h3>
      </article>
      <article class="comparison-card">
        <div class="comparison" style="--position:50%">
          <img
            class="comparison-after"
            src="/assets/images/transformation-img-after-2.webp"
            width="1200"
            height="800"
            alt="Después: ejemplo de armonía de la sonrisa"
            loading="lazy"
          />
          <img
            class="comparison-before"
            src="/assets/images/transformation-img-before-2.webp"
            width="1200"
            height="800"
            alt="Antes: imagen original de la sonrisa ilustrativa"
            loading="lazy"
          />
          <span class="compare-label label-before">Antes</span>
          <span class="compare-label label-after">Después</span>
          <div class="comparison-divider" aria-hidden="true">
            <span>‹ ›</span>
          </div>
          <input
            class="comparison-slider"
            type="range"
            min="0"
            max="100"
            value="50"
            aria-label="Comparar antes y después de la armonía de la sonrisa"
            aria-valuetext="50% de la imagen antes visible"
          />
        </div>
        <h3>Armonía de la sonrisa</h3>
      </article>
      <article class="comparison-card">
        <div class="comparison" style="--position:50%">
          <img
            class="comparison-after"
            src="/assets/images/transformation-img-after-3.webp"
            width="1200"
            height="800"
            alt="Después: sonrisa ilustrativa sin brackets"
            loading="lazy"
          />
          <img
            class="comparison-before"
            src="/assets/images/transformation-img-before-3.webp"
            width="1200"
            height="800"
            alt="Antes: sonrisa ilustrativa con brackets"
            loading="lazy"
          />
          <span class="compare-label label-before">Antes</span>
          <span class="compare-label label-after">Después</span>
          <div class="comparison-divider" aria-hidden="true">
            <span>‹ ›</span>
          </div>
          <input
            class="comparison-slider"
            type="range"
            min="0"
            max="100"
            value="50"
            aria-label="Comparar antes y después de la alineación dental"
            aria-valuetext="50% de la imagen antes visible"
          />
        </div>
        <h3>Alineación dental</h3>
      </article>
    </div>
    <p class="fine-print centered">
      Imágenes de demostración. Los resultados dependen de cada caso.
    </p>
  </div>
</section>
