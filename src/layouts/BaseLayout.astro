---
import '../styles/global.css';
import { site } from '../data/site';
import IconDefinitions from '../components/IconDefinitions.astro';
interface Props {
  title?: string;
  description?: string;
}
const { title = site.title, description = site.description } = Astro.props;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="theme-color" content="#342137" />
    <meta name="whatsapp-number" content={site.whatsappNumber} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/assets/fonts/manrope-600.ttf"
      as="font"
      type="font/ttf"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/assets/fonts/source-sans-3-400.ttf"
      as="font"
      type="font/ttf"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/assets/images/hero-image.webp"
      as="image"
      fetchpriority="high"
    />
  </head>
  <body>
    <a class="skip-link" href="#contenido">
      Saltar al contenido
    </a>
    <IconDefinitions />
    <slot />
    <script>
      import '../scripts/interactions';
    </script>
  </body>
</html>
