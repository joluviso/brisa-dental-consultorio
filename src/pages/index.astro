---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import About from '../components/About.astro';
import Treatments from '../components/Treatments.astro';
import CarePhilosophy from '../components/CarePhilosophy.astro';
import Experience from '../components/Experience.astro';
import Team from '../components/Team.astro';
import Transformations from '../components/Transformations.astro';
import Stories from '../components/Stories.astro';
import Appointment from '../components/Appointment.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import Journal from '../components/Journal.astro';
import Footer from '../components/Footer.astro';
import MobileContact from '../components/MobileContact.astro';
---

<BaseLayout>
  <Header />
  <main id="contenido">
    <Hero />
    <TrustStrip />
    <About />
    <Treatments />
    <CarePhilosophy />
    <Experience />
    <Team />
    <Transformations />
    <Stories />
    <Appointment />
    <Testimonials />
    <FAQ />
    <Journal />
  </main>
  <Footer />
  <MobileContact />
</BaseLayout>
